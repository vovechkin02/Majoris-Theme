<?xml version="1.0" encoding="UTF-8"?>
<!-- Majoris source-editor semantic palette. Comments tuned for readability; no font policy. -->
<style-scheme id="majoris-light" name="Majoris Light" version="1.0">
  <author>Majoris</author>
  <description>Majoris light editor and syntax colours</description>
  <color name="keyword" value="#7C3AED"/>
  <color name="string" value="#117D60"/>
  <color name="type" value="#2563B0"/>
  <color name="comment" value="${text_secondary}"/>
  <color name="number" value="#B45309"/>
  <color name="selection" value="#E8E9FF"/>
  <color name="gutter" value="${background}"/>
  <color name="match" value="#E0E7FF"/>
  <color name="error" value="#B92F3E"/>
  <color name="warning" value="#9A5400"/>
  <style name="text" foreground="${text}" background="${surface}"/>
  <style name="selection" foreground="${text}" background="selection"/>
  <style name="selection-unfocused" foreground="${text}" background="${hover}"/>
  <style name="cursor" foreground="${text}"/>
  <style name="secondary-cursor" foreground="${text_secondary}"/>
  <style name="current-line" background="${surface_secondary}"/>
  <style name="line-numbers" foreground="comment" background="gutter"/>
  <style name="current-line-number" foreground="${text}" background="${surface_secondary}" bold="true"/>
  <style name="right-margin" foreground="${border_soft}" background="${surface_secondary}"/>
  <style name="draw-spaces" foreground="${text_secondary}"/>
  <style name="bracket-match" foreground="${text}" background="match" bold="true"/>
  <style name="bracket-mismatch" foreground="error" underline="error"/>
  <style name="search-match" foreground="${text}" background="match"/>
  <style name="background-pattern" background="${surface_secondary}"/>
  <style name="snippet-focus" background="match"/>
  <style name="def:keyword" foreground="keyword"/>
  <style name="def:statement" foreground="keyword"/>
  <style name="def:preprocessor" foreground="keyword"/>
  <style name="def:operator" foreground="keyword"/>
  <style name="def:heading" foreground="keyword" bold="true"/>
  <style name="def:list-marker" foreground="keyword"/>
  <style name="def:string" foreground="string"/>
  <style name="def:character" foreground="string"/>
  <style name="def:net-address" foreground="string"/>
  <style name="def:link-text" foreground="string"/>
  <style name="def:link-destination" foreground="string" underline="single"/>
  <style name="def:inline-code" foreground="string"/>
  <style name="def:preformatted-section" foreground="string"/>
  <style name="def:insertion" foreground="string"/>
  <style name="diff:added-line" foreground="string"/>
  <style name="def:type" foreground="type"/>
  <style name="def:function" foreground="type"/>
  <style name="def:identifier" foreground="type"/>
  <style name="xml:tags" foreground="type"/>
  <style name="xml:attribute-name" foreground="type"/>
  <style name="json:keyname" foreground="type"/>
  <style name="def:attribute" foreground="type"/>
  <style name="def:property" foreground="type"/>
  <style name="def:comment" foreground="comment" italic="true"/>
  <style name="def:doc-comment" foreground="comment"/>
  <style name="def:doc-comment-element" foreground="comment"/>
  <style name="def:shebang" foreground="comment"/>
  <style name="def:number" foreground="number"/>
  <style name="def:decimal" foreground="number"/>
  <style name="def:base-n-integer" foreground="number"/>
  <style name="def:floating-point" foreground="number"/>
  <style name="def:boolean" foreground="number"/>
  <style name="def:constant" foreground="number"/>
  <style name="def:special-char" foreground="number"/>
  <style name="def:error" foreground="error" underline="error"/>
  <style name="def:deletion" foreground="error"/>
  <style name="diff:removed-line" foreground="error"/>
  <style name="def:warning" foreground="warning" underline="single"/>
  <style name="def:note" foreground="warning"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="diff:changed-line" foreground="warning"/>
</style-scheme>
