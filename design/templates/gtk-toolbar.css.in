/* Universal opt-in toolbar; legacy purpose names are compatibility aliases. */
.majoris-toolbar, .majoris-toolbar-navigation, .majoris-toolbar-commands { min-height: ${toolbar_content}; padding: ${.majoris-toolbar|padding}; border: none; background-color: @surface; box-shadow: none; border-spacing: 0; font-size: ${.majoris-toolbar|font-size}; font-weight: ${.majoris-toolbar|font-weight}; }
.majoris-toolbar-divider { background-image: linear-gradient(@border_soft,@border_soft); background-size: 100% 1px; background-position: bottom; background-repeat: no-repeat; }
.majoris-toolbar-group { padding: 0; border: none; background: transparent; box-shadow: none; border-spacing: 0; }
.majoris-toolbar-major-groups { border-spacing: 0; }
.majoris-toolbar-spacer { min-width: 0; padding: 0; border: none; background: transparent; box-shadow: none; }
separator.majoris-toolbar-separator { min-width: 1px; min-height: 1px; padding: 0; border: none; margin: 4px 0; background: @border_soft; box-shadow: none; }
button.majoris-toolbar-control, menubutton.majoris-toolbar-control > button { min-height: ${toolbar_control_content}; padding: ${.majoris-toolbar-control|padding}; border-radius: ${.majoris-toolbar-control|border-radius}; font-size: ${.majoris-toolbar-control|font-size}; font-weight: ${.majoris-toolbar-control|font-weight}; }
button.majoris-toolbar-icon, menubutton.majoris-toolbar-icon > button { min-width: 16px; min-height: 16px; padding: ${toolbar_icon_padding}; }
button.majoris-toolbar-control > image, button.majoris-toolbar-control > box > image, menubutton.majoris-toolbar-control > button > image, menubutton.majoris-toolbar-control > button > box > image { -gtk-icon-size: 16px; padding: 0; margin: 0; }
button.majoris-toolbar-menu, menubutton.majoris-toolbar-menu > button { font-weight: ${.majoris-toolbar-menu|font-weight}; }
button.majoris-toolbar-action > box { border-spacing: 0; }
entry.majoris-toolbar-field, searchentry.majoris-toolbar-field { min-height: ${toolbar_control_content}; padding: ${.majoris-toolbar-field|padding}; font-size: ${.majoris-toolbar-field|font-size}; font-weight: ${.majoris-toolbar-field|font-weight}; }
.majoris-toolbar-metadata { font-size: ${.majoris-toolbar-metadata|font-size}; font-weight: ${.majoris-toolbar-metadata|font-weight}; color: @text_secondary; }
.majoris-toolbar-segmented , .majoris-toolbar-view-switcher { min-height: ${toolbar_switch_content}; padding: ${toolbar_switch_padding}; border: 1px solid @border; border-radius: ${.majoris-toolbar-segmented|border-radius}; background: ${.majoris-toolbar-segmented|background}; box-shadow: none; border-spacing: ${.majoris-toolbar-segmented|gap}; }
.majoris-toolbar-segmented > button , .majoris-toolbar-view-switcher > button { min-height: ${toolbar_segment_content}; min-width: 16px; padding: 2px 4px; margin: 0; border: none; border-radius: ${.majoris-toolbar-segmented button|border-radius}; background: transparent; background-image: none; color: @text_secondary; box-shadow: none; font-size: ${.majoris-toolbar-segmented button|font-size}; font-weight: ${.majoris-toolbar-segmented button|font-weight}; transition: background-color ${control_motion}, color ${control_motion}, box-shadow ${control_motion}; }
.majoris-toolbar-segmented > button image , .majoris-toolbar-view-switcher > button image { min-width: 16px; min-height: 16px; padding: 0; margin: 0; -gtk-icon-size: 16px; }
.majoris-toolbar-segmented > button:hover , .majoris-toolbar-view-switcher > button:hover { background: @hover; box-shadow: none; }
.majoris-toolbar-segmented > button:active , .majoris-toolbar-view-switcher > button:active { background: @active; box-shadow: none; }
.majoris-toolbar-segmented > button:checked, .majoris-toolbar-segmented > button:checked:hover , .majoris-toolbar-view-switcher > button:checked, .majoris-toolbar-view-switcher > button:checked:hover { background: ${.majoris-toolbar-segmented button.active|background}; color: @text; font-weight: ${.majoris-toolbar-segmented button.active|font-weight}; box-shadow: ${control_shadow}; }
.majoris-toolbar-segmented > button:focus-visible , .majoris-toolbar-view-switcher > button:focus-visible { outline: 2px solid ${editor_focus}; outline-offset: -2px; box-shadow: none; }
.majoris-toolbar-segmented > button:disabled, .majoris-toolbar-segmented > button:disabled:hover , .majoris-toolbar-view-switcher > button:disabled, .majoris-toolbar-view-switcher > button:disabled:hover { background: transparent; color: @text_tertiary; box-shadow: none; }
.majoris-toolbar-segmented > button:checked:disabled , .majoris-toolbar-view-switcher > button:checked:disabled { background: ${.majoris-toolbar-segmented button.active|background}; }
.majoris-toolbar:backdrop { color: @text_secondary; }

button.majoris-toolbar-control:disabled:hover, button.majoris-toolbar-control:disabled:active, menubutton.majoris-toolbar-control > button:disabled:hover, menubutton.majoris-toolbar-control > button:disabled:active { background-color: ${toolbar_button_surface}; color: @text_tertiary; border-color: @border; box-shadow: none; }
button.majoris-toolbar-control:backdrop, menubutton.majoris-toolbar-control > button:backdrop { color: @text_secondary; }
.majoris-toolbar-segmented:backdrop > button:checked , .majoris-toolbar-view-switcher:backdrop > button:checked { color: @text_secondary; }

/* Density targets only explicitly designated items, preserving nested composites. */
.majoris-toolbar-compact button.majoris-toolbar-control, .majoris-toolbar-compact menubutton.majoris-toolbar-control > button, .majoris-toolbar-compact entry.majoris-toolbar-field, .majoris-toolbar-compact searchentry.majoris-toolbar-field { min-height: ${toolbar_compact_content}; }
.majoris-toolbar-compact button.majoris-toolbar-icon, .majoris-toolbar-compact menubutton.majoris-toolbar-icon > button { min-height: 16px; padding: ${toolbar_compact_icon_padding}; }
dropdown.majoris-toolbar-select > button, combobox.majoris-toolbar-select > box > button { min-height: ${toolbar_control_content}; padding: 0 8px; font-size: 14px; font-weight: 500; border-radius: 4px; }
.majoris-toolbar-compact dropdown.majoris-toolbar-select > button, .majoris-toolbar-compact combobox.majoris-toolbar-select > box > button { min-height: ${toolbar_compact_content}; }
button.majoris-toolbar-control.majoris-toolbar-item-flat, menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button { background: transparent; border-color: transparent; box-shadow: none; }
button.majoris-toolbar-control.majoris-toolbar-item-flat:hover, menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button:hover { background: @hover; box-shadow: none; }
button.majoris-toolbar-control.majoris-toolbar-item-flat:active, menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button:active { background: @active; box-shadow: none; }
button.majoris-toolbar-control.majoris-toolbar-item-flat:checked, button.majoris-toolbar-control.majoris-toolbar-item-flat:checked:hover { background: @hover; color: @text; box-shadow: none; }
button.majoris-toolbar-control.majoris-toolbar-item-flat:focus-visible, menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button:focus-visible { outline: 2px solid ${editor_focus}; outline-offset: -2px; box-shadow: none; }
button.majoris-toolbar-control.majoris-toolbar-item-flat:disabled, button.majoris-toolbar-control.majoris-toolbar-item-flat:disabled:hover, button.majoris-toolbar-control.majoris-toolbar-item-flat:disabled:active, menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button:disabled { background: transparent; border-color: transparent; color: @text_tertiary; box-shadow: none; }

button.majoris-toolbar-control.majoris-toolbar-item-flat:checked:disabled { background: @hover; color: @text; }

scale.majoris-toolbar-scale { min-height: ${.majoris-toolbar-scale|min-height}; padding: ${.majoris-toolbar-scale|padding}; }
.majoris-toolbar-compact scale.majoris-toolbar-scale { min-height: ${.majoris-toolbar-compact .majoris-toolbar-scale|min-height}; }

/* Gtk.Box.spacing owns the base gap. Only logical boundaries add its difference. */
.majoris-toolbar-group-gap { margin-left: 4px; }
.majoris-toolbar-group-gap:dir(rtl) { margin-left: 0; margin-right: 4px; }
.majoris-toolbar-major-groups > .majoris-toolbar-group-gap { margin-left: 12px; }
.majoris-toolbar-major-groups > .majoris-toolbar-group-gap:dir(rtl) { margin-left: 0; margin-right: 12px; }
button.majoris-toolbar-control.majoris-toolbar-item-flat, menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button { font-weight: ${.majoris-toolbar-control.majoris-toolbar-item-flat|font-weight}; }
button.majoris-toolbar-control.majoris-toolbar-item-flat:checked { font-weight: ${.majoris-toolbar-control.majoris-toolbar-item-flat.active|font-weight}; }
/* Pointer focus never inherits the generic keyboard focus shadow/border. */
button.majoris-toolbar-control:focus:not(:focus-visible), menubutton.majoris-toolbar-control > button:focus:not(:focus-visible) { outline: none; border-color: @border; box-shadow: ${control_shadow}; }
button.majoris-toolbar-control.majoris-toolbar-item-flat:focus:not(:focus-visible) { border-color: transparent; box-shadow: none; }
button.majoris-toolbar-control:focus-visible, menubutton.majoris-toolbar-control > button:focus-visible { outline: 2px solid ${editor_focus}; outline-offset: -2px; border-color: @border; box-shadow: none; }
button.majoris-toolbar-control.majoris-toolbar-item-flat:focus-visible { border-color: transparent; }
.majoris-toolbar-segmented > button:focus:not(:focus-visible), .majoris-toolbar-view-switcher > button:focus:not(:focus-visible) { outline: none; }
button.majoris-toolbar-control:disabled, menubutton.majoris-toolbar-control > button:disabled,
.majoris-toolbar-segmented > button:disabled, .majoris-toolbar-view-switcher > button:disabled { opacity: ${.majoris-toolbar-control:disabled|opacity}; color: @text; filter: none; -gtk-icon-filter: none; box-shadow: none; outline: none; }
button.majoris-toolbar-control:disabled:hover, button.majoris-toolbar-control:disabled:active, menubutton.majoris-toolbar-control > button:disabled:hover, menubutton.majoris-toolbar-control > button:disabled:active { color: @text; }
button.majoris-toolbar-control.majoris-toolbar-item-flat:disabled, button.majoris-toolbar-control.majoris-toolbar-item-flat:disabled:hover, button.majoris-toolbar-control.majoris-toolbar-item-flat:disabled:active { background: transparent; color: @text; outline: none; border-color: transparent; box-shadow: none; }
/* A single opacity layer: menu wrappers, labels and glyphs remain opaque. */
menubutton.majoris-toolbar-control:disabled { opacity: 1; filter: none; }
button.majoris-toolbar-control > image:disabled, button.majoris-toolbar-control > label:disabled, button.majoris-toolbar-control > box:disabled,
button.majoris-toolbar-control > box > image:disabled, button.majoris-toolbar-control > box > label:disabled,
menubutton.majoris-toolbar-control > button > label:disabled, menubutton.majoris-toolbar-control > button > image:disabled,
menubutton.majoris-toolbar-control > button > box:disabled, menubutton.majoris-toolbar-control > button > box > label:disabled, menubutton.majoris-toolbar-control > button > box > image:disabled,
.majoris-toolbar-view-switcher > button > label:disabled, .majoris-toolbar-view-switcher > button > image:disabled,
.majoris-toolbar-segmented > button > label:disabled, .majoris-toolbar-segmented > button > image:disabled { opacity: 1; color: inherit; filter: none; -gtk-icon-filter: none; }

/* CSS-only legacy GTK4 rows keep native spacing 0; the installed component
 * always has .majoris-toolbar and uses native spacing 4. GTK3 uses native 4. */
.majoris-toolbar-navigation:not(.majoris-toolbar), .majoris-toolbar-commands:not(.majoris-toolbar) { border-spacing: 4px; }
.majoris-toolbar-navigation:not(.majoris-toolbar) > .majoris-toolbar-group:not(.majoris-toolbar-native-group), .majoris-toolbar-commands:not(.majoris-toolbar) > .majoris-toolbar-group:not(.majoris-toolbar-native-group) { border-spacing: 4px; }
.majoris-toolbar-navigation:not(.majoris-toolbar) > :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer) + .majoris-toolbar-group, .majoris-toolbar-navigation:not(.majoris-toolbar) > .majoris-toolbar-group + :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer),
.majoris-toolbar-commands:not(.majoris-toolbar) > :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer) + .majoris-toolbar-group, .majoris-toolbar-commands:not(.majoris-toolbar) > .majoris-toolbar-group + :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer) { margin-left: 4px; }
.majoris-toolbar-navigation:not(.majoris-toolbar) > :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer) + .majoris-toolbar-group:dir(rtl), .majoris-toolbar-navigation:not(.majoris-toolbar) > .majoris-toolbar-group + :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer):dir(rtl),
.majoris-toolbar-commands:not(.majoris-toolbar) > :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer) + .majoris-toolbar-group:dir(rtl), .majoris-toolbar-commands:not(.majoris-toolbar) > .majoris-toolbar-group + :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer):dir(rtl) { margin-left: 0; margin-right: 4px; }

.majoris-toolbar-major-groups:not(.majoris-toolbar) > :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer) + .majoris-toolbar-group,
.majoris-toolbar-major-groups:not(.majoris-toolbar) > .majoris-toolbar-group + :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer) { margin-left: 12px; }
.majoris-toolbar-major-groups:not(.majoris-toolbar) > :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer) + .majoris-toolbar-group:dir(rtl),
.majoris-toolbar-major-groups:not(.majoris-toolbar) > .majoris-toolbar-group + :not(.majoris-toolbar-separator):not(.majoris-toolbar-spacer):dir(rtl) { margin-left: 0; margin-right: 12px; }
menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button:focus:not(:focus-visible) { outline: none; border-color: transparent; box-shadow: none; }
menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button:focus-visible { border-color: transparent; }
menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button:disabled, menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button:disabled:hover, menubutton.majoris-toolbar-control.majoris-toolbar-item-flat > button:disabled:active { background: transparent; color: @text; border-color: transparent; box-shadow: none; }
.majoris-toolbar-segmented > button:disabled:hover, .majoris-toolbar-segmented > button:disabled:active, .majoris-toolbar-view-switcher > button:disabled:hover, .majoris-toolbar-view-switcher > button:disabled:active { color: @text; background: transparent; box-shadow: none; outline: none; }
.majoris-toolbar-segmented > button:checked:disabled:hover, .majoris-toolbar-view-switcher > button:checked:disabled:hover { background: ${.majoris-toolbar-segmented button.active|background}; }
