/* Opt-in composite textbox: outer field owns border/elevation, inner controls stay flat. */
.majoris-location-bar { min-width: 0; padding: 2px; border: 1px solid @border; border-radius: ${control_radius}; background: ${.entry|background}; color: @text; box-shadow: ${control_shadow}; font-size: ${.majoris-location-bar|font-size}; font-weight: ${.majoris-location-crumb|font-weight}; transition: ${.entry|transition}; }
.majoris-location-bar.majoris-location-editing:focus-within { border-color: ${.entry:focus|border-color}; outline: none; box-shadow: ${.entry:focus|box-shadow}; }
.majoris-location-bar button.majoris-location-crumb { min-width: 0; min-height: 24px; padding: 0 6px; margin: 0; border: 1px solid transparent; border-radius: ${control_radius}; background: transparent; background-image: none; color: @text; box-shadow: none; outline: none; font-size: ${.majoris-location-bar|font-size}; font-weight: ${.majoris-location-crumb|font-weight}; transition: background-color ${control_motion}, color ${control_motion}, box-shadow ${control_motion}; }
.majoris-location-bar button.majoris-location-crumb:hover { background: @hover; color: @text; box-shadow: none; }
.majoris-location-bar button.majoris-location-crumb:active { background: @active; color: @text; box-shadow: none; }
.majoris-location-bar button.majoris-location-crumb:focus-visible { outline: 2px solid ${editor_focus}; outline-offset: -2px; box-shadow: none; }
.majoris-location-bar button.majoris-location-current { color: @text; font-weight: ${.majoris-location-current|font-weight}; }
.majoris-location-separator { color: @text_secondary; padding: 0 2px; }
.majoris-location-bar entry.majoris-location-entry, .majoris-location-bar entry.majoris-location-entry:focus-within { min-width: 0; min-height: 24px; padding: 0 6px; border: 1px solid transparent; border-radius: ${control_radius}; background: transparent; color: @text; outline: none; box-shadow: none; font-size: ${.majoris-location-bar|font-size}; font-weight: ${.majoris-location-crumb|font-weight}; }
.majoris-location-bar button.majoris-location-crumb:disabled, .majoris-location-bar button.majoris-location-crumb:disabled:hover, .majoris-location-bar button.majoris-location-crumb:disabled:active { background: transparent; color: @text_tertiary; font-weight: 500; opacity: .45; box-shadow: none; outline: none; }
.majoris-location-bar:backdrop { background: ${.entry|background}; border-color: @border; }
.majoris-location-bar button.majoris-location-crumb:backdrop { color: @text_secondary; background: transparent; box-shadow: none; outline: none; }
.majoris-location-bar.majoris-high-contrast { border-color: @text; }
.majoris-location-bar.majoris-high-contrast button.majoris-location-crumb, .majoris-location-bar.majoris-high-contrast .majoris-location-separator { color: @text; }
.majoris-location-bar:disabled { color: @text_tertiary; opacity: .45; box-shadow: none; }
.majoris-location-bar:disabled button.majoris-location-crumb:disabled, .majoris-location-bar:disabled entry.majoris-location-entry:disabled { opacity: 1; }
