/* All appearance rules live in the theme, never in the factory. */
* { font-family: "Plus Jakarta Sans", "Noto Sans", "Cantarell", sans-serif; }
window { font-size: ${.btn|font-size}; }
window, .background { background-color: @background; color: @text; }
button, entry, spinbutton, combobox, dropdown > button {
  min-height: ${control_content_size}; padding: ${.btn|padding}; border: 1px solid @border;
  border-radius: ${control_radius}; background-color: @surface; background-image: none;
  color: @text; box-shadow: ${control_shadow}; font-weight: 600;
  transition: background-color ${control_motion}, border-color ${control_motion}, box-shadow ${control_motion}, color ${control_motion}, opacity ${control_motion};
}
button:hover, entry:hover, dropdown > button:hover { background-color: @hover; box-shadow: ${control_hover_shadow}; }
button:active, button:checked { background-color: @active; box-shadow: ${control_active_shadow}; }
button:disabled, entry:disabled, dropdown:disabled { opacity: ${.btn:disabled|opacity}; box-shadow: none; }
button:focus, entry:focus, entry:focus-within, dropdown:focus-within { outline: none; border-color: @primary_500; box-shadow: 0 0 0 2px rgba(99,102,241,.24), ${control_shadow}; }
button.suggested-action { background-color: @primary_600; border-color: @primary_600; color: @surface; box-shadow: ${.btn.primary|box-shadow}; }
button.suggested-action:hover { background-color: @primary_700; border-color: @primary_700; box-shadow: ${.btn.primary:hover|box-shadow}; }
button.suggested-action:active { background-color: @primary_800; border-color: @primary_800; box-shadow: ${.btn.primary:active|box-shadow}; }
button.suggested-action:focus { box-shadow: ${.btn.primary:focus-visible|box-shadow}; }
button.destructive-action { background-color: @danger; border-color: @danger; color: @surface; box-shadow: ${.btn.danger|box-shadow}; }
button.destructive-action:hover { background-color: mix(@danger, black, .05); box-shadow: ${.btn.danger:hover|box-shadow}; }
button.destructive-action:focus { border-color: @primary_500; box-shadow: ${.is-focus|box-shadow}; }
button.destructive-action:active { background-color: mix(@danger, black, .10); box-shadow: ${.btn.danger:active|box-shadow}; }
button.flat, button.flat:hover, button.flat:active, button.flat:checked { border-color: transparent; box-shadow: none; background-image: none; }
button.flat { background-color: transparent; }
button.flat:hover { background-color: @hover; }
button.flat:active { background-color: @active; }
button.flat:focus { outline: none; border-color: @primary_500; box-shadow: 0 0 0 2px rgba(99,102,241,.24); }
button:disabled, button.suggested-action:disabled, button.destructive-action:disabled, button.flat:disabled { box-shadow: none; }
button.image-button { min-width: ${control_content_size}; padding: 0; }
entry, spinbutton { padding: ${.entry|padding}; font-weight: 400; }
entry { min-width: ${entry_content_width}; }
spinbutton { padding: 0; }
spinbutton button { min-height: ${control_content_size}; min-width: 27px; padding: 0; border: none; border-left: 1px solid @border_soft; border-radius: 0; background-color: transparent; box-shadow: none; }
spinbutton button:hover { background-color: @hover; box-shadow: none; }
spinbutton button:active { background-color: @active; box-shadow: none; }
spinbutton entry { min-width: 34px; border: none; box-shadow: none; background: transparent; }
headerbar { min-height: ${window_control_size}; padding: ${header_padding_top} ${header_padding} ${header_padding_bottom}; border-radius: 0; border: none; border-bottom: 1px solid @border_soft; background-color: ${.headerbar|background}; background-image: none; box-shadow: none; }
headerbar button, headerbar entry, headerbar dropdown > button { min-height: ${control_content_size}; margin: 0; padding-top: 0; padding-bottom: 0; }
headerbar .title { font-size: ${.title|font-size}; font-weight: ${.title|font-weight}; }
check, radio { min-width: 16px; min-height: 16px; padding: 0; margin: 0; border: 1px solid @border; background-color: @surface; color: @surface; box-shadow: ${.checkbox|box-shadow}; }
check { border-radius: ${.checkbox|border-radius}; }
radio { border-radius: ${.radio|border-radius}; }
check:checked, radio:checked { background-color: @primary_500; border-color: @primary_500; }
check:indeterminate { background-color: @surface; color: @primary_600; border-color: @border; }
check:focus, radio:focus, switch:focus { outline: 2px solid alpha(@primary_500,.24); outline-offset: 2px; }
check:disabled, radio:disabled, switch:disabled { opacity: .45; }
switch { min-width: 34px; min-height: 16px; padding: 2px; border: 1px solid @border; border-radius: ${.switch|border-radius}; background-color: @surface_secondary; background-image: none; box-shadow: ${.switch|box-shadow}; }
switch:checked { background-color: @primary_500; border-color: @primary_500; }
switch:hover { box-shadow: ${.switch:hover|box-shadow}; }
switch slider { min-width: 14px; min-height: 14px; margin: 0; padding: 0; border: ${.switch:after|border}; border-radius: ${.switch:after|border-radius}; background-color: @surface; background-image: none; box-shadow: ${.switch:after|box-shadow}; }
scale trough { min-height: ${.track|height}; border-radius: ${.track|border-radius}; background-color: ${.track|background}; }
scale highlight { background-color: @primary_500; border-radius: ${control_radius}; }
scale slider { min-width: 12px; min-height: 12px; border: 2px solid @primary_500; border-radius: 50%; background-color: @surface; box-shadow: ${control_shadow}; }
progressbar trough { min-height: ${.progress|height}; border: none; border-radius: ${.progress|border-radius}; background-color: ${.progress|background}; }
progressbar progress { min-height: ${.progress|height}; border: none; background-color: @primary_500; border-radius: ${.progress|border-radius}; }
levelbar trough { min-height: ${.level|height}; padding: 0; background: transparent; }
levelbar block { min-height: ${.level|height}; min-width: 8px; margin: 0 1px; border: none; border-radius: ${.level span|border-radius}; }
levelbar block.filled { background-color: @success; }
levelbar block.empty { background-color: ${.level span|background}; }
/* Native GtkSpinner uses the exact generated vector; toolkit rotates it. */
spinner { min-width: ${.spinner|width}; min-height: ${.spinner|height}; color: @primary_600; background: none; -gtk-icon-source: url("assets/spinner.svg"); }
notebook > header { background: @surface; border: none; border-bottom: 1px solid @border_soft; padding: 0 6px; }
notebook > header tabs { margin: 0; padding: 0; }
notebook > header tab { min-height: ${.tab|height}; padding: ${.tab|padding}; margin: 0; border: none; border-radius: ${control_radius}; background: transparent; color: @text_secondary; box-shadow: none; font-size: ${.tab|font-size}; }
notebook > header tab:hover { background-color: ${.tab:hover|background}; }
notebook > header tab:active { background-color: ${.tab:active|background}; }
notebook > header tab:checked { color: @text; font-weight: ${.tab.active|font-weight}; border: none; background-image: linear-gradient(to right, transparent 10px, @primary_500 10px, @primary_500 calc(100% - 10px), transparent calc(100% - 10px)); background-size: 100% 2px; background-repeat: no-repeat; background-position: bottom; box-shadow: none; }
.majoris-segmented, viewswitcher, stackswitcher { background-color: @surface_secondary; border: 1px solid @border; border-radius: ${.toggle-group|border-radius}; padding: ${.toggle-group|padding}; }
.majoris-segmented button, viewswitcher button, stackswitcher button { min-height: ${.toggle|height}; padding: ${.toggle|padding}; margin: 0; border: none; border-radius: ${control_radius}; background: transparent; color: @text_secondary; box-shadow: none; font-size: ${.toggle|font-size}; font-weight: 400; }
.majoris-segmented button { margin-right: ${.toggle-group|gap}; }
.majoris-segmented button:last-child { margin-right: 0; }
.majoris-segmented button:hover, viewswitcher button:hover, stackswitcher button:hover { background-color: ${.toggle:hover|background}; box-shadow: none; }
.majoris-segmented button:active, viewswitcher button:active, stackswitcher button:active { background-color: ${.toggle:active|background}; box-shadow: none; }
.majoris-segmented button:checked, viewswitcher button:checked, stackswitcher button:checked { background-color: @surface; color: @text; font-weight: 600; box-shadow: ${control_shadow}; }
row { border-radius: ${control_radius}; }
row:hover { background-color: @hover; }
row:selected { background-color: @primary_50; color: @primary_800; }
.sidebar, .navigation-sidebar, .majoris-sidebar { background-color: @surface_secondary; padding: ${.sidebar|padding}; border-right: 1px solid @border_soft; }
.sidebar row, .navigation-sidebar row, .majoris-sidebar row { min-height: ${.nav|height}; padding: ${.nav|padding}; margin-bottom: ${.nav|margin-bottom}; border: none; border-radius: ${.nav|border-radius}; }
.sidebar row:selected, .navigation-sidebar row:selected, .majoris-sidebar row:selected { background-color: @primary_50; color: @primary_700; font-weight: ${.nav.active|font-weight}; background-image: linear-gradient(to bottom, transparent 9px, @primary_500 9px, @primary_500 calc(100% - 9px), transparent calc(100% - 9px)); background-size: 2px 100%; background-position: left; background-repeat: no-repeat; }
.majoris-data-view row { padding: ${.table-row div|padding}; font-size: ${.table-row|font-size}; border-top: 1px solid @border_soft; }
.majoris-data-view row:selected { background-color: @primary_50; color: @primary_800; }
.boxed-list.majoris-data-view > row { min-height: 0; padding: ${.table-row div|padding}; }
.card, .boxed-list { border: 1px solid @border_soft; border-radius: ${structure_radius}; background-color: @surface; }
.card { box-shadow: ${card_shadow}; }
.boxed-list { box-shadow: none; }
.card, .boxed-list, popover, dialog { transition: background-color ${surface_motion}, box-shadow ${surface_motion}; }
.boxed-list > row { min-height: ${preference_content_height}; padding: ${.pref-row|padding}; border-bottom: 1px solid @border_soft; border-radius: 0; }
.boxed-list > row:last-child { border-bottom: none; }
.boxed-list > row label { font-size: ${.pref-title|font-size}; }
.boxed-list > row .title { font-weight: ${.pref-title|font-weight}; }
.boxed-list > row .subtitle { font-size: ${.pref-desc|font-size}; color: @text_secondary; font-weight: 400; }
tooltip { border-radius: ${.tooltip|border-radius}; border: none; background-color: ${.tooltip|background}; color: @surface; padding: ${.tooltip|padding}; box-shadow: ${pop_shadow}; font-size: ${.tooltip|font-size}; }
tooltip label { font-size: ${.tooltip|font-size}; }
scrollbar, scrollbar trough { background: transparent; border: none; }
scrollbar slider { min-width: ${.scroll-thumb|width}; min-height: 6px; margin: 0; border: none; border-radius: ${.scroll-thumb|border-radius}; background-color: ${.scroll-thumb|background}; }
scrollbar slider:hover { background-color: @text_secondary; }
scrollbar slider:active { background-color: @text; }
dialog { border-radius: ${structure_radius}; background-color: @surface; }
:not(.sourceview) > text > selection, entry selection, searchentry selection, passwordentry selection, spinbutton selection, label selection, textview:not(.sourceview) selection { background-color: @primary_200; color: @text; }
.majoris-card-header { padding: ${.card-head|padding}; border-bottom: 1px solid @border_soft; }
/* Opt-in layout boundaries: never also add margins to these containers. */
.majoris-card-body { padding: ${.card-body|padding}; }
.majoris-card-footer { padding: 12px ${.card-body|padding}; border-top: 1px solid @border_soft; }
.majoris-page-content { padding: ${.content|padding}; }
.majoris-page-content.majoris-compact { padding: ${.card-body|padding}; }
.majoris-card-header .heading { font-size: ${.card-head h3|font-size}; }
treeview.view:selected, iconview.view:selected { background-color: @primary_50; color: @primary_800; }
checkbutton:disabled, radiobutton:disabled { opacity: .45; }
checkbutton:disabled check, radiobutton:disabled radio { opacity: 1; }
tooltip.background { background-color: ${.tooltip|background}; color: @surface; border-radius: ${.tooltip|border-radius}; }
tooltip > box { background: transparent; color: @surface; padding: 0; border: none; border-radius: ${.tooltip|border-radius}; box-shadow: none; }
tooltip label { color: @surface; }
.majoris-card-description { font-size: ${.card-head p|font-size}; color: @text_secondary; }

@keyframes majoris-spin { to { -gtk-icon-transform: rotate(360deg); } }
spinner:checked { opacity: 1; animation: majoris-spin 800ms linear infinite; }
.title-1 { font-size: ${.page-title|font-size}; font-weight: 700; letter-spacing: ${.page-title|letter-spacing}; }

/* Desktop Icons NG: desktopwindow compatibility, emitted after native overrides. */
window.desktopwindow,
window.desktopwindow:backdrop,
window.desktopwindow.background,
window.desktopwindow.background:backdrop,
.desktopwindow,
.desktopwindow:backdrop {
    background-color: transparent;
    background-image: none;
    border-color: transparent;
    border-width: 0;
    border-radius: 0;
    box-shadow: none;
}
