project('majoris-login-resources', version: '0.1.0', meson_version: '>=1.3', license: 'MIT')
gnome = import('gnome')
python = find_program('python3')
gnome.compile_resources('majoris-login', 'resources.gresource.xml', gresource_bundle: true, install: true, install_dir: get_option('datadir') / 'majoris-login')
install_subdir('theme', install_dir: get_option('datadir') / 'majoris-login', exclude_files: ['tokens.json'])
install_subdir('assets/wallpapers', install_dir: get_option('datadir') / 'majoris-login/assets')
install_subdir('assets/icons', install_dir: get_option('datadir') / 'icons/hicolor/scalable/actions', strip_directory: true)
install_subdir('assets/fonts/static', install_dir: get_option('datadir') / 'fonts/truetype/majoris-login', strip_directory: true)
install_data('assets/fonts/OFL.txt', install_dir: get_option('datadir') / 'doc/majoris-login-resources')
install_data('config/org.majoris.login.gschema.xml', install_dir: get_option('datadir') / 'glib-2.0/schemas')
install_data('config/20-majoris-login', install_dir: get_option('sysconfdir') / 'dconf/db/gdm.d')
install_data('scripts/restore.sh', install_dir: get_option('sbindir'), rename: 'majoris-login-restore', install_mode: 'rwxr-xr-x')
install_data('scripts/install.sh', install_dir: get_option('datadir') / 'majoris-login/scripts', install_mode: 'rwxr-xr-x')
install_subdir('docs', install_dir: get_option('datadir') / 'doc/majoris-login-resources')
test('login contracts', python, args: [files('tests/test-contracts.py')])
